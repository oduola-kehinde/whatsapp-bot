/*
|--------------------------------------------------------------------------
| Graceful shutdown
|--------------------------------------------------------------------------
*/

async function shutdown(signal) {

    console.log(
        `Received ${signal}. Shutting down...`
    );

    try {

        if (whatsappClient) {
            await whatsappClient.destroy();
        }

    } catch (error) {

        console.error(
            error.message
        );
    }

    try {

        if (pool) {
            await pool.end();
        }

    } catch {}

    process.exit(0);
}

process.on(
    "SIGINT",
    () => shutdown("SIGINT")
