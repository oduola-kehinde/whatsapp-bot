/*
|--------------------------------------------------------------------------
| Send WhatsApp message
|--------------------------------------------------------------------------
*/

app.post(
    "/api/whatsapp/send",
    auth,
    async (req, res) => {

        try {

            const number =
                String(
                    req.body.number || ""
                ).replace(
                    /[^\d]/g,
                    ""
                );

            const message =
                String(
                    req.body.message || ""
                ).trim();

            if (!number) {

                return res.status(400).json({
                    ok: false,
                    error:
                        "number is required"
                });
            }

            if (!message) {

                return res.status(400).json({
                    ok: false,
                    error:
                        "message is required"
                });
            }

            if (!whatsappClient) {

                return res.status(503).json({
                    ok: false,
                    error:
                        "WhatsApp client is not running"
                });
            }

            if (!whatsappReady) {

                return res.status(503).json({
                    ok: false,
                    error:
                        "WhatsApp is not connected"
                });
            }

            const exists =
                await whatsappClient
                    .isRegisteredUser(
                        number
                    );

            if (!exists) {

                return res.status(400).json({
                    ok: false,
                    error:
                        "This number is not registered on WhatsApp"
                });
            }

            const chatId =
                `${number}@c.us`;

            const sent =
                await whatsappClient
                    .sendMessage(
                        chatId,
                        message
                    );

            /*
            |--------------------------------------------------------------------------
            | Save outgoing message
            |--------------------------------------------------------------------------
            */

            if (pool) {

                try {

                    await db(`
                        INSERT INTO messages
                        (
                            remote_number,
                            direction,
                            message_type,
                            body
                        )
                        VALUES
                        ($1,$2,$3,$4)
                    `, [
                        number,
                        "outgoing",
                        "text",
                        message
                    ]);

                } catch (error) {

                    console.error(
                        "Outgoing message database error:",
                        error.message
                    );
                }
            }

            res.json({

                ok: true,

                id:
                    sent.id?._serialized ||
                    null,

                to:
                    number
            });

        } catch (error) {

            console.error(
                "Send error:",
                error
            );

            res.status(500).json({

                ok: false,

                error:
                    error.message
            });
        }
    }
);

