require("dotenv").config();

const express = require("express");
const cors = require("cors");
const bcrypt = require("bcryptjs");
const jwt = require("jsonwebtoken");
const QRCode = require("qrcode");
const qrcodeTerminal = require("qrcode-terminal");
const { Pool } = require("pg");
const path = require("path");
const fs = require("fs");

const {
    Client,
    LocalAuth
} = require("whatsapp-web.js");

/*
|--------------------------------------------------------------------------
| CONFIGURATION
|--------------------------------------------------------------------------
*/

const app = express();

const PORT = Number(process.env.PORT || 3000);
const HOST = process.env.HOST || "0.0.0.0";

const JWT_SECRET =
    process.env.JWT_SECRET ||
    "CHANGE_THIS_SECRET_BEFORE_PRODUCTION";

const WORKER_ID =
    process.env.WORKER_ID ||
    "main-bot";

const NODE_ENV =
    process.env.NODE_ENV ||
    "development";

/*
|--------------------------------------------------------------------------
| EXPRESS
|--------------------------------------------------------------------------
*/

app.disable("x-powered-by");

app.use(
    cors({
        origin: true,
        credentials: true
    })
);

app.use(
    express.json({
        limit: "10mb"
    })
);

app.use(
    express.urlencoded({
        extended: true,
        limit: "10mb"
    })
);

app.use(
    express.static(
        path.join(__dirname, "public")
    )
);

/*
|--------------------------------------------------------------------------
| DATABASE
|--------------------------------------------------------------------------
*/

let pool = null;

if (process.env.DATABASE_URL) {
    pool = new Pool({
        connectionString:
            process.env.DATABASE_URL,

        ssl:
            process.env.DATABASE_SSL === "false"
                ? false
                : {
                    rejectUnauthorized: false
                },

        max:
            Number(
                process.env.DB_POOL_MAX || 10
            ),

        idleTimeoutMillis: 30000,

        connectionTimeoutMillis: 10000
    });

    pool.on(
        "error",
        error => {
            console.error(
                "PostgreSQL pool error:",
                error.message
            );
        }
    );

    console.log(
        "PostgreSQL configured."
    );
} else {
    console.warn(
        "WARNING: DATABASE_URL is not configured."
    );
}

async function db(
    queryText,
    params = []
) {
    if (!pool) {
        throw new Error(
            "DATABASE_URL is not configured."
        );
    }

    return pool.query(
        queryText,
        params
    );
}

/*
|--------------------------------------------------------------------------
| DATABASE INITIALIZATION
|--------------------------------------------------------------------------
*/

async function initializeDatabase() {

    if (!pool) {
        console.log(
            "Skipping database initialization."
        );
        return;
    }

    await db(`
        CREATE TABLE IF NOT EXISTS users (
            id SERIAL PRIMARY KEY,

            email TEXT UNIQUE NOT NULL,

            password_hash TEXT NOT NULL,

            role TEXT NOT NULL
                DEFAULT 'customer',

            created_at TIMESTAMPTZ NOT NULL
                DEFAULT NOW()
        );

        CREATE TABLE IF NOT EXISTS whatsapp_accounts (
            id SERIAL PRIMARY KEY,

            user_id INTEGER
                REFERENCES users(id)
                ON DELETE CASCADE,

            name TEXT NOT NULL,

            phone TEXT,

            status TEXT NOT NULL
                DEFAULT 'disconnected',

            session_name TEXT UNIQUE NOT NULL,

            created_at TIMESTAMPTZ NOT NULL
                DEFAULT NOW()
        );

        CREATE TABLE IF NOT EXISTS messages (
            id SERIAL PRIMARY KEY,

            whatsapp_account_id INTEGER
                REFERENCES whatsapp_accounts(id)
                ON DELETE CASCADE,

            remote_number TEXT,

            direction TEXT NOT NULL,

            message_type TEXT NOT NULL
                DEFAULT 'text',

            body TEXT,

            media_url TEXT,

            created_at TIMESTAMPTZ NOT NULL
                DEFAULT NOW()
        );

        CREATE TABLE IF NOT EXISTS automation_rules (
            id SERIAL PRIMARY KEY,

            whatsapp_account_id INTEGER
                REFERENCES whatsapp_accounts(id)
                ON DELETE CASCADE,

            trigger_text TEXT NOT NULL,

            reply_text TEXT NOT NULL,

            enabled BOOLEAN NOT NULL
                DEFAULT TRUE,

            created_at TIMESTAMPTZ NOT NULL
                DEFAULT NOW()
        );

        CREATE TABLE IF NOT EXISTS media (
            id SERIAL PRIMARY KEY,

            whatsapp_account_id INTEGER
                REFERENCES whatsapp_accounts(id)
                ON DELETE CASCADE,

            filename TEXT NOT NULL,

            mime_type TEXT,

            storage_url TEXT,

            created_at TIMESTAMPTZ NOT NULL
                DEFAULT NOW()
        );

        CREATE INDEX IF NOT EXISTS
            idx_messages_created_at
        ON messages(created_at DESC);

        CREATE INDEX IF NOT EXISTS
            idx_messages_remote_number
        ON messages(remote_number);

        CREATE INDEX IF NOT EXISTS
            idx_accounts_user_id
        ON whatsapp_accounts(user_id);

        CREATE INDEX IF NOT EXISTS
            idx_rules_account_id
        ON automation_rules(
            whatsapp_account_id
        );
    `);

    console.log(
        "Database initialized successfully."
    );
}

/*
|--------------------------------------------------------------------------
| JWT AUTHENTICATION
|--------------------------------------------------------------------------
*/

function createToken(user) {

    return jwt.sign(
        {
            id: user.id,
            email: user.email,
            role: user.role
        },

        JWT_SECRET,

        {
            expiresIn:
                process.env.JWT_EXPIRES_IN ||
                "7d"
        }
    );
}

function auth(
    req,
    res,
    next
) {

    const header =
        req.headers.authorization || "";

    if (
        !header.startsWith(
            "Bearer "
        )
    ) {
        return res.status(401).json({
            ok: false,
            error:
                "Authentication required"
        });
    }

    const token =
        header.substring(7);

    try {

        req.user =
            jwt.verify(
                token,
                JWT_SECRET
            );

        next();

    } catch {

        return res.status(401).json({
            ok: false,
            error:
                "Invalid or expired token"
        });
    }
}

function adminOnly(
    req,
    res,
    next
) {

    if (
        req.user.role !== "admin"
    ) {
        return res.status(403).json({
            ok: false,
            error:
                "Administrator access required"
        });
    }

    next();
}

/*
|--------------------------------------------------------------------------
| WHATSAPP STATE
|--------------------------------------------------------------------------
*/

let whatsappClient = null;

let whatsappReady = false;

let whatsappState =
    "STARTING";

let whatsappInfo = null;

let lastQR = null;

let whatsappStarting = false;

/*
|--------------------------------------------------------------------------
| CHROME / PUPPETEER
|--------------------------------------------------------------------------
*/

function getChromePath() {

    if (process.env.CHROME_BIN) {

        return process.env.CHROME_BIN;
    }

    try {

        const puppeteer =
            require("puppeteer");

        if (
            puppeteer &&
            typeof puppeteer.executablePath ===
                "function"
        ) {

            const executable =
                puppeteer.executablePath();

            if (
                executable &&
                fs.existsSync(executable)
            ) {

                return executable;
            }
        }

    } catch (error) {

        console.warn(
            "Unable to detect Puppeteer Chrome:",
            error.message
        );
    }

    return undefined;
}

/*
|--------------------------------------------------------------------------
| ACCOUNT HELPERS
|--------------------------------------------------------------------------
*/

async function getMainAccountId() {

    if (!pool) {
        return null;
    }

    try {

        const result =
            await db(`
                SELECT id
                FROM whatsapp_accounts
                ORDER BY id ASC
                LIMIT 1
            `);

        return (
            result.rows[0]?.id ||
            null
        );

    } catch {

        return null;
    }
}

async function updateMainAccount(
    status,
    phone = null
) {

    if (!pool) {
        return;
    }

    try {

        const accountId =
            await getMainAccountId();

        if (!accountId) {
            return;
        }

        await db(`
            UPDATE whatsapp_accounts
            SET
                status=$1,
                phone=$2
            WHERE id=$3
        `, [
            status,
            phone,
            accountId
        ]);

    } catch (error) {

        console.error(
            "Account update error:",
            error.message
        );
    }
}

/*
|--------------------------------------------------------------------------
| CREATE WHATSAPP CLIENT
|--------------------------------------------------------------------------
*/

function createWhatsAppClient() {

    const chromePath =
        getChromePath();

    if (chromePath) {

        console.log(
            "Chrome executable:",
            chromePath
        );

    } else {

        console.log(
            "Puppeteer will use its configured browser."
        );
    }

    const clientOptions = {

        authStrategy:
            new LocalAuth({
                clientId:
                    WORKER_ID,

                dataPath:
                    process.env.WHATSAPP_SESSION_PATH ||
                    path.join(
                        __dirname,
                        ".wwebjs_auth"
                    )
            }),

        puppeteer: {

            headless: true,

            args: [
                "--no-sandbox",
                "--disable-setuid-sandbox",
                "--disable-dev-shm-usage",
                "--disable-gpu",
                "--no-first-run",
                "--no-zygote",
                "--disable-extensions",
                "--disable-background-networking",
                "--disable-background-timer-throttling",
                "--disable-renderer-backgrounding",
                "--disable-features=Translate,BackForwardCache"
            ]
        }
    };

    if (chromePath) {

        clientOptions.puppeteer.executablePath =
            chromePath;
    }

    const client =
        new Client(
            clientOptions
        );

    /*
    |--------------------------------------------------------------------------
    | QR CODE
    |--------------------------------------------------------------------------
    */

    client.on(
        "qr",
        qr => {

            lastQR = qr;

            whatsappReady =
                false;

            whatsappState =
                "QR_REQUIRED";

            console.log("");

            console.log(
                "======================================"
            );

            console.log(
                "WHATSAPP QR CODE REQUIRED"
            );

            console.log(
                "SCAN THE QR CODE WITH WHATSAPP"
            );

            console.log(
                "======================================"
            );

            qrcodeTerminal.generate(
                qr,
                {
                    small: true
                }
            );

            console.log("");

            updateMainAccount(
                "qr_required"
            );
        }
    );

    /*
    |--------------------------------------------------------------------------
    | AUTHENTICATED
    |--------------------------------------------------------------------------
    */

    client.on(
        "authenticated",
        () => {

            whatsappState =
                "AUTHENTICATED";

            console.log(
                "WhatsApp authentication successful."
            );
        }
    );

    /*
    |--------------------------------------------------------------------------
    | READY
    |--------------------------------------------------------------------------
    */

    client.on(
        "ready",
        async () => {

            whatsappReady =
                true;

            lastQR = null;

            whatsappState =
                "READY";

            try {

                whatsappInfo = {

                    pushname:
                        client.info?.pushname ||
                        null,

                    phone:
                        client.info?.wid?.user ||
                        null,

                    platform:
                        client.info?.platform ||
                        null
                };

            } catch {

                whatsappInfo =
                    null;
            }

            console.log("");

            console.log(
                "======================================"
            );

            console.log(
                "WHATSAPP CONNECTED"
            );

            console.log(
                "======================================"
            );

            console.log(
                "Number:",
                whatsappInfo?.phone ||
                "unknown"
            );

            console.log(
                "Name:",
                whatsappInfo?.pushname ||
                "unknown"
            );

            console.log(
                "Platform:",
                whatsappInfo?.platform ||
                "unknown"
            );

            console.log("");

            await updateMainAccount(
                "connected",
                whatsappInfo?.phone ||
                null
            );
        }
    );

    /*
    |--------------------------------------------------------------------------
    | AUTH FAILURE
    |--------------------------------------------------------------------------
    */

    client.on(
        "auth_failure",
        message => {

            whatsappReady =
                false;

            whatsappState =
                "AUTH_FAILURE";

            console.error(
                "WhatsApp authentication failure:",
                message
            );

            updateMainAccount(
                "auth_failure"
            );
        }
    );

    /*
    |--------------------------------------------------------------------------
    | DISCONNECTED
    |--------------------------------------------------------------------------
    */

    client.on(
        "disconnected",
        reason => {

            whatsappReady =
                false;

            whatsappState =
                "DISCONNECTED";

            whatsappInfo =
                null;

            console.log(
                "WhatsApp disconnected:",
                reason
            );

            updateMainAccount(
                "disconnected"
            );
        }
    );

    /*
    |--------------------------------------------------------------------------
    | INCOMING MESSAGE
    |--------------------------------------------------------------------------
    */

    client.on(
        "message",
        async message => {

            try {

                const text =
                    String(
                        message.body || ""
                    ).trim();

                if (!text) {
                    return;
                }

                console.log(
                    `[MESSAGE] ${message.from}: ${text}`
                );

                /*
                |--------------------------------------------------------------------------
                | GET MAIN ACCOUNT
                |--------------------------------------------------------------------------
                */

                const accountId =
                    await getMainAccountId();

                /*
                |--------------------------------------------------------------------------
                | SAVE INCOMING MESSAGE
                |--------------------------------------------------------------------------
                */

                if (pool) {

                    try {

                        await db(`
                            INSERT INTO messages
                            (
                                whatsapp_account_id,
                                remote_number,
                                direction,
                                message_type,
                                body
                            )
                            VALUES
                            ($1,$2,$3,$4,$5)
                        `, [
                            accountId,
                            message.from,
                            "incoming",
                            "text",
                            text
                        ]);

                    } catch (error) {

                        console.error(
                            "Incoming message database error:",
                            error.message
                        );
                    }
                }

                /*
                |--------------------------------------------------------------------------
                | BUILT-IN COMMANDS
                |--------------------------------------------------------------------------
                */

                const command =
                    text.toLowerCase();

                if (
                    command === "!ping"
                ) {

                    await message.reply(
                        "pong"
                    );

                    return;
                }

                if (
                    command === "!status"
                ) {

                    await message.reply(
                        whatsappReady
                            ? "Bot is online and connected."
                            : "Bot is currently offline."
                    );

                    return;
                }

                if (
                    command === "!help"
                ) {

                    await message.reply(
                        "WhatsApp Bot Commands\n\n" +
                        "!ping - Test the bot\n" +
                        "!status - Check bot status\n" +
                        "!help - Show commands"
                    );

                    return;
                }

                /*
                |--------------------------------------------------------------------------
                | AUTOMATION RULES
                |--------------------------------------------------------------------------
                */

                if (
                    pool &&
                    accountId
                ) {

                    try {

                        const rules =
                            await db(`
                                SELECT
                                    id,
                                    trigger_text,
                                    reply_text,
                                    enabled
                                FROM automation_rules
                                WHERE
                                    whatsapp_account_id=$1
                                    AND enabled=true
                                ORDER BY id ASC
                            `, [
                                accountId
                            ]);

                        const matchedRule =
                            rules.rows.find(
                                rule => {

                                    const trigger =
                                        String(
                                            rule.trigger_text ||
                                            ""
                                        )
                                        .trim()
                                        .toLowerCase();

                                    return (
                                        trigger &&
                                        command ===
                                            trigger
                                    );
                                }
                            );

                        if (
                            matchedRule
                        ) {

                            await message.reply(
                                matchedRule.reply_text
                            );

                            await db(`
                                INSERT INTO messages
                                (
                                    whatsapp_account_id,
                                    remote_number,
                                    direction,
                                    message_type,
                                    body
                                )
                                VALUES
                                ($1,$2,$3,$4,$5)
                            `, [
                                accountId,
                                message.from,
                                "outgoing",
                                "text",
                                matchedRule.reply_text
                            ]);
                        }

                    } catch (error) {

                        console.error(
                            "Automation error:",
                            error.message
                        );
                    }
                }

            } catch (error) {

                console.error(
                    "Message handler error:",
                    error
                );
            }
        }
    );

    /*
    |--------------------------------------------------------------------------
    | WHATSAPP ERROR
    |--------------------------------------------------------------------------
    */

    client.on(
        "error",
        error => {

            console.error(
                "WhatsApp client error:",
                error
            );
        }
    );

    return client;
}

/*
|--------------------------------------------------------------------------
| START WHATSAPP
|--------------------------------------------------------------------------
*/

async function startWhatsApp() {

    if (whatsappStarting) {
        return;
    }

    whatsappStarting =
        true;

    whatsappState =
        "STARTING";

    console.log(
        "Starting WhatsApp client..."
    );

    try {

        whatsappClient =
            createWhatsAppClient();

        await whatsappClient.initialize();

    } catch (error) {

        whatsappReady =
            false;

        whatsappState =
            "INITIALIZATION_ERROR";

        console.error(
            "WhatsApp initialization failed:"
        );

        console.error(
            error
        );

    } finally {

        whatsappStarting =
            false;
    }
}

/*
|--------------------------------------------------------------------------
| HEALTH
|--------------------------------------------------------------------------
*/

app.get(
    "/health",
    async (req, res) => {

        let database =
            false;

        if (pool) {

            try {

                await db(
                    "SELECT 1"
                );

                database =
                    true;

            } catch {

                database =
                    false;
            }
        }

        res.json({

            ok: true,

            service:
                "whatsapp-automation-platform",

            environment:
                NODE_ENV,

            database,

            whatsapp: {

                ready:
                    whatsappReady,

                state:
                    whatsappState,

                info:
                    whatsappInfo
            },

            timestamp:
                new Date().toISOString()
        });
    }
);

/*
|--------------------------------------------------------------------------
| WHATSAPP STATUS
|--------------------------------------------------------------------------
*/

app.get(
    "/api/whatsapp/status",
    async (req, res) => {

        try {

            let qr =
                null;

            if (lastQR) {

                qr =
                    await QRCode.toDataURL(
                        lastQR
                    );
            }

            res.json({

                ok: true,

                ready:
                    whatsappReady,

                state:
                    whatsappState,

                qr,

                info:
                    whatsappInfo
            });

        } catch (error) {

            res.status(500).json({

                ok: false,

                error:
                    error.message
            });
        }
    }
);

/*
|--------------------------------------------------------------------------
| RESTART WHATSAPP
|--------------------------------------------------------------------------
*/

app.post(
    "/api/whatsapp/restart",
    auth,
    adminOnly,
    async (req, res) => {

        try {

            if (whatsappClient) {

                try {

                    await whatsappClient.destroy();

                } catch {}
            }

            whatsappClient =
                null;

            whatsappReady =
                false;

            whatsappState =
                "RESTARTING";

            lastQR =
                null;

            whatsappInfo =
                null;

            await startWhatsApp();

            res.json({

                ok: true,

                message:
                    "WhatsApp restart requested."
            });

        } catch (error) {

            res.status(500).json({

                ok: false,

                error:
                    error.message
            });
        }
    }
);

/*
|--------------------------------------------------------------------------
| SEND WHATSAPP MESSAGE
|--------------------------------------------------------------------------
*/

app.post(
    "/api/whatsapp/send",
    auth,
    async (req, res) => {

        try {

            const number =
                String(
                    req.body.number || ""
                )
                .replace(
                    /[^\d]/g,
                    ""
                );

            const message =
                String(
                    req.body.message || ""
                )
                .trim();

            if (!number) {

                return res.status(400).json({

                    ok: false,

                    error:
                        "number is required"
                });
            }

            if (!message) {

                return res.status(400).json({

                    ok: false,

                    error:
                        "message is required"
                });
            }

            if (!whatsappClient) {

                return res.status(503).json({

                    ok: false,

                    error:
                        "WhatsApp client is not running"
                });
            }

            if (!whatsappReady) {

                return res.status(503).json({

                    ok: false,

                    error:
                        "WhatsApp is not connected"
                });
            }

            const exists =
                await whatsappClient
                    .isRegisteredUser(
                        number
                    );

            if (!exists) {

                return res.status(400).json({

                    ok: false,

                    error:
                        "This number is not registered on WhatsApp"
                });
            }

            const chatId =
                `${number}@c.us`;

            const sent =
                await whatsappClient
                    .sendMessage(
                        chatId,
                        message
                    );

            const accountId =
                await getMainAccountId();

            if (pool) {

                try {

                    await db(`
                        INSERT INTO messages
                        (
                            whatsapp_account_id,
                            remote_number,
                            direction,
                            message_type,
                            body
                        )
                        VALUES
                        ($1,$2,$3,$4,$5)
                    `, [
                        accountId,
                        number,
                        "outgoing",
                        "text",
                        message
                    ]);

                } catch (error) {

                    console.error(
                        "Outgoing message database error:",
                        error.message
                    );
                }
            }

            res.json({

                ok: true,

                id:
                    sent.id?._serialized ||
                    null,

                to:
                    number
            });

        } catch (error) {

            console.error(
                "Send error:",
                error
            );

            res.status(500).json({

                ok: false,

                error:
                    error.message
            });
        }
    }
);

/*
|--------------------------------------------------------------------------
| REGISTER
|--------------------------------------------------------------------------
*/

app.post(
    "/api/auth/register",
    async (req, res) => {

        try {

            if (!pool) {

                return res.status(503).json({

                    ok: false,

                    error:
                        "DATABASE_URL is not configured"
                });
            }

            const email =
                String(
                    req.body.email || ""
                )
                .trim()
                .toLowerCase();

            const password =
                String(
                    req.body.password || ""
                );

            if (
                !email ||
                password.length < 6
            ) {

                return res.status(400).json({

                    ok: false,

                    error:
                        "Valid email and password of at least 6 characters are required"
                });
            }

            const hash =
                await bcrypt.hash(
                    password,
                    12
                );

            const result =
                await db(`
                    INSERT INTO users
                    (
                        email,
                        password_hash
                    )
                    VALUES
                    ($1,$2)
                    RETURNING
                        id,
                        email,
                        role,
                        created_at
                `, [
                    email,
                    hash
                ]);

            const user =
                result.rows[0];

            res.status(201).json({

                ok: true,

                user,

                token:
                    createToken(user)
            });

        } catch (error) {

            if (
                error.code ===
                "23505"
            ) {

                return res.status(409).json({

                    ok: false,

                    error:
                        "Email already exists"
                });
            }

            console.error(
                "Registration error:",
                error
            );

            res.status(500).json({

                ok: false,

                error:
                    "Registration failed"
            });
        }
    }
);

/*
|--------------------------------------------------------------------------
| LOGIN
|--------------------------------------------------------------------------
*/

app.post(
    "/api/auth/login",
    async (req, res) => {

        try {

            if (!pool) {

                return res.status(503).json({

                    ok: false,

                    error:
                        "DATABASE_URL is not configured"
                });
            }

            const email =
                String(
                    req.body.email || ""
                )
                .trim()
                .toLowerCase();

            const password =
                String(
                    req.body.password || ""
                );

            const result =
                await db(`
                    SELECT
                        id,
                        email,
                        password_hash,
                        role,
                        created_at
                    FROM users
                    WHERE email=$1
                `, [
                    email
                ]);

            if (
                !result.rows.length
            ) {

                return res.status(401).json({

                    ok: false,

                    error:
                        "Invalid email or password"
                });
            }

            const user =
                result.rows[0];

            const valid =
                await bcrypt.compare(
                    password,
                    user.password_hash
                );

            if (!valid) {

                return res.status(401).json({

                    ok: false,

                    error:
                        "Invalid email or password"
                });
            }

            delete user.password_hash;

            res.json({

                ok: true,

                user,

                token:
                    createToken(user)
            });

        } catch (error) {

            console.error(
                "Login error:",
                error
            );

            res.status(500).json({

                ok: false,

                error:
                    "Login failed"
            });
        }
    }
);

