/*
|--------------------------------------------------------------------------
| ADMIN - CHANGE USER ROLE
|--------------------------------------------------------------------------
*/

app.patch(
    "/api/admin/users/:id/role",
    auth,
    adminOnly,
    async (req, res) => {

        try {

            if (!pool) {

                return res.status(503).json({

                    ok: false,

                    error:
                        "DATABASE_URL is not configured"
                });
            }

            const userId =
                Number(
                    req.params.id
                );

            const role =
                String(
                    req.body.role || ""
                ).trim();

            if (
                role !== "admin" &&
                role !== "customer"
            ) {

                return res.status(400).json({

                    ok: false,

                    error:
                        "role must be admin or customer"
                });
            }

            const result =
                await db(`
                    UPDATE users
                    SET role=$1
                    WHERE id=$2
                    RETURNING
                        id,
                        email,
                        role,
                        created_at
                `, [
                    role,
                    userId
                ]);

            if (
                !result.rows.length
            ) {

                return res.status(404).json({

                    ok: false,

                    error:
                        "User not found"
                });
            }

            res.json({

                ok: true,

                user:
                    result.rows[0]
            });

        } catch (error) {

            console.error(
                "Role update error:",
                error
            );

            res.status(500).json({

                ok: false,

                error:
                    "Unable to update user role"
            });
        }
    }
);

/*
|--------------------------------------------------------------------------
| ADMIN - DELETE USER
|--------------------------------------------------------------------------
*/

app.delete(
    "/api/admin/users/:id",
    auth,
    adminOnly,
    async (req, res) => {

        try {

            if (!pool) {

                return res.status(503).json({

                    ok: false,

                    error:
                        "DATABASE_URL is not configured"
                });
            }

            const userId =
                Number(
                    req.params.id
                );

            if (
                userId === req.user.id
            ) {

                return res.status(400).json({

                    ok: false,

                    error:
                        "You cannot delete your own administrator account"
                });
            }

            const result =
                await db(`
                    DELETE FROM users
                    WHERE id=$1
                    RETURNING
                        id,
                        email
                `, [
                    userId
                ]);

            if (
                !result.rows.length
            ) {

                return res.status(404).json({

                    ok: false,

                    error:
                        "User not found"
                });
            }

            res.json({

                ok: true,

                deleted:
                    result.rows[0]
            });

        } catch (error) {

            console.error(
                "Delete user error:",
                error
            );

            res.status(500).json({

                ok: false,

                error:
                    "Unable to delete user"
            });
        }
    }
);

