app.get(
    "/api/accounts",
    auth,
    async (req, res) => {

        try {

            if (!pool) {
                return res.json([]);
            }

            let result;

            if (
                req.user.role ===
                "admin"
            ) {

                result =
                    await db(`
                        SELECT
                            id,
                            user_id,
                            name,
                            phone,
                            status,
                            session_name,
                            created_at
                        FROM whatsapp_accounts
                        ORDER BY id DESC
                    `);

            } else {

                result =
                    await db(`
                        SELECT
                            id,
                            user_id,
                            name,
                            phone,
                            status,
                            session_name,
                            created_at
                        FROM whatsapp_accounts
                        WHERE user_id=$1
                        ORDER BY id DESC
                    `, [
                        req.user.id
                    ]);
            }

            res.json(
                result.rows
            );

        } catch (error) {

            console.error(
                "Accounts error:",
                error
            );

            res.status(500).json({

                ok: false,

                error:
                    "Unable to load accounts"
            });
        }
    }
);

/*
|--------------------------------------------------------------------------
| CREATE ACCOUNT
|--------------------------------------------------------------------------
*/

app.post(
    "/api/accounts",
    auth,
    async (req, res) => {

        try {

            if (!pool) {

                return res.status(503).json({

                    ok: false,

                    error:
                        "DATABASE_URL is not configured"
                });
            }

            const name =
                String(
                    req.body.name || ""
                ).trim();

            if (!name) {

                return res.status(400).json({

                    ok: false,

                    error:
                        "Account name is required"
                });
            }

            const sessionName =
                `wa-${req.user.id}-${Date.now()}`;

            const result =
                await db(`
                    INSERT INTO whatsapp_accounts
                    (
                        user_id,
                        name,
                        session_name
                    )
                    VALUES
                    ($1,$2,$3)
                    RETURNING *
                `, [
                    req.user.id,
                    name,
                    sessionName
                ]);

            res.status(201).json({

                ok: true,

                account:
                    result.rows[0]
            });

        } catch (error) {

            console.error(
                "Create account error:",
                error
            );

            res.status(500).json({

                ok: false,

                error:
                    "Unable to create WhatsApp account"
            });
        }
    }
);

/*
|--------------------------------------------------------------------------
| DELETE ACCOUNT
|--------------------------------------------------------------------------
*/

app.delete(
    "/api/accounts/:id",
    auth,
    async (req, res) => {

        try {

            if (!pool) {

                return res.status(503).json({

                    ok: false,

                    error:
                        "DATABASE_URL is not configured"
                });
            }

            const accountId =
                Number(
                    req.params.id
                );

            const result =
                await db(`
                    SELECT
                        id,
                        user_id
                    FROM whatsapp_accounts
                    WHERE id=$1
                `, [
                    accountId
                ]);

            if (
                !result.rows.length
            ) {

                return res.status(404).json({

                    ok: false,

                    error:
                        "Account not found"
                });
            }

            const account =
                result.rows[0];

            if (
                req.user.role !== "admin" &&
                account.user_id !== req.user.id
            ) {

                return res.status(403).json({

                    ok: false,

                    error:
                        "You do not own this account"
                });
            }

            await db(`
                DELETE FROM whatsapp_accounts
                WHERE id=$1
            `, [
                accountId
            ]);

            res.json({

                ok: true
            });

        } catch (error) {

            console.error(
                "Delete account error:",
                error
            );

            res.status(500).json({

                ok: false,

                error:
                    "Unable to delete account"
            });
        }
    }
);

