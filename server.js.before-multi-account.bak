/*
|--------------------------------------------------------------------------
| CREATE AUTOMATION RULE
|--------------------------------------------------------------------------
*/

app.post(
    "/api/rules",
    auth,
    async (req, res) => {

        try {

            if (!pool) {

                return res.status(503).json({

                    ok: false,

                    error:
                        "DATABASE_URL is not configured"
                });
            }

            const accountId =
                Number(
                    req.body.whatsapp_account_id
                );

            const triggerText =
                String(
                    req.body.trigger_text ||
                    ""
                ).trim();

            const replyText =
                String(
                    req.body.reply_text ||
                    ""
                ).trim();

            const enabled =
                req.body.enabled === undefined
                    ? true
                    : Boolean(
                        req.body.enabled
                    );

            if (
                !accountId ||
                !triggerText ||
                !replyText
            ) {

                return res.status(400).json({

                    ok: false,

                    error:
                        "whatsapp_account_id, trigger_text and reply_text are required"
                });
            }

            const account =
                await db(`
                    SELECT
                        id,
                        user_id
                    FROM whatsapp_accounts
                    WHERE id=$1
                `, [
                    accountId
                ]);

            if (
                !account.rows.length
            ) {

                return res.status(404).json({

                    ok: false,

                    error:
                        "WhatsApp account not found"
                });
            }

            if (
                req.user.role !== "admin" &&
                account.rows[0].user_id !==
                    req.user.id
            ) {

                return res.status(403).json({

                    ok: false,

                    error:
                        "You do not own this account"
                });
            }

            const result =
                await db(`
                    INSERT INTO automation_rules
                    (
                        whatsapp_account_id,
                        trigger_text,
                        reply_text,
                        enabled
                    )
                    VALUES
                    ($1,$2,$3,$4)
                    RETURNING *
                `, [
                    accountId,
                    triggerText,
                    replyText,
                    enabled
                ]);

            res.status(201).json({

                ok: true,

                rule:
                    result.rows[0]
            });

        } catch (error) {

            console.error(
                "Create rule error:",
                error
            );

            res.status(500).json({

                ok: false,

                error:
                    "Unable to create automation rule"
            });
        }
    }
);

/*
|--------------------------------------------------------------------------
| UPDATE AUTOMATION RULE
|--------------------------------------------------------------------------
*/

app.patch(
    "/api/rules/:id",
    auth,
    async (req, res) => {

        try {

            if (!pool) {

                return res.status(503).json({

                    ok: false,

                    error:
                        "DATABASE_URL is not configured"
                });
            }

            const ruleId =
                Number(
                    req.params.id
                );

            const existing =
                await db(`
                    SELECT
                        r.*,
                        a.user_id
                    FROM automation_rules r
                    JOIN whatsapp_accounts a
                      ON a.id =
                         r.whatsapp_account_id
                    WHERE r.id=$1
                `, [
                    ruleId
                ]);

            if (
                !existing.rows.length
            ) {

                return res.status(404).json({

                    ok: false,

                    error:
                        "Automation rule not found"
                });
            }

            const oldRule =
                existing.rows[0];

            if (
                req.user.role !== "admin" &&
                oldRule.user_id !== req.user.id
            ) {

                return res.status(403).json({

                    ok: false,

                    error:
                        "You do not own this rule"
                });
            }

            const triggerText =
                String(
                    req.body.trigger_text ??
                    oldRule.trigger_text
                ).trim();

            const replyText =
                String(
                    req.body.reply_text ??
                    oldRule.reply_text
                ).trim();

            const enabled =
                req.body.enabled === undefined
                    ? oldRule.enabled
                    : Boolean(
                        req.body.enabled
                    );

            const result =
                await db(`
                    UPDATE automation_rules
                    SET
                        trigger_text=$1,
                        reply_text=$2,
                        enabled=$3
                    WHERE id=$4
                    RETURNING *
                `, [
                    triggerText,
                    replyText,
                    enabled,
                    ruleId
                ]);

            res.json({

                ok: true,

                rule:
                    result.rows[0]
            });

        } catch (error) {

            console.error(
                "Update rule error:",
                error
            );

            res.status(500).json({

                ok: false,

                error:
                    "Unable to update automation rule"
            });
        }
    }
);

