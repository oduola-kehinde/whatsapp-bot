require("dotenv").config();

const {
    Client,
    LocalAuth
} = require("whatsapp-web.js");

const qrcode = require("qrcode-terminal");
const puppeteer = require("puppeteer");

const workerId = process.env.WORKER_ID || "worker-1";

let isReady = false;

console.log("");
console.log("======================================");
console.log(" WHATSAPP AUTOMATION PLATFORM");
console.log(" WHATSAPP WORKER");
console.log("======================================");
console.log("Worker:", workerId);
console.log("Starting WhatsApp client...");
console.log("");

const chromePath = puppeteer.executablePath();

console.log("Chrome executable:");
console.log(chromePath);
console.log("");

const client = new Client({
    authStrategy: new LocalAuth({
        clientId: workerId
    }),

    puppeteer: {
        headless: true,

        executablePath: chromePath,

        args: [
            "--no-sandbox",
            "--disable-setuid-sandbox",
            "--disable-dev-shm-usage",
            "--disable-gpu",
            "--disable-software-rasterizer",
            "--no-first-run",
            "--no-zygote",
            "--disable-extensions"
        ]
    }
});

client.on("qr", (qr) => {
    console.log("");
    console.log("======================================");
    console.log(" SCAN THIS QR CODE WITH WHATSAPP");
    console.log("======================================");
    console.log("");

    qrcode.generate(qr, {
        small: true
    });

    console.log("");
});

client.on("authenticated", () => {
    console.log("WhatsApp authentication successful.");
});

client.on("ready", () => {
    isReady = true;

    console.log("");
    console.log("======================================");
    console.log(" WHATSAPP CONNECTED");
    console.log("======================================");

    try {
        const info = client.info;

        console.log(
            "Number:",
            info?.wid?.user || "unknown"
        );

        console.log(
            "Push name:",
            info?.pushname || "unknown"
        );

        console.log(
            "Platform:",
            info?.platform || "unknown"
        );
    } catch (error) {
        console.error(
            "Unable to read WhatsApp account info:",
            error.message
        );
    }

    console.log("");
});

client.on("auth_failure", (message) => {
    isReady = false;

    console.error("");
    console.error("======================================");
    console.error(" WHATSAPP AUTHENTICATION FAILED");
    console.error("======================================");
    console.error(message);
});

client.on("disconnected", (reason) => {
    isReady = false;

    console.log("");
    console.log("WhatsApp disconnected:", reason);
    console.log("");
});

client.on("change_state", (state) => {
    console.log("WhatsApp state:", state);
});

client.on("message", async (message) => {
    try {
        const text = String(message.body || "").trim();

        console.log(
            "[MESSAGE]",
            message.from,
            ":",
            text
        );

        if (!text) {
            return;
        }

        if (text.toLowerCase() === "!ping") {
            await message.reply("pong");
            return;
        }

        if (text.toLowerCase() === "!status") {
            await message.reply(
                isReady
                    ? "WhatsApp automation is online."
                    : "WhatsApp automation is currently offline."
            );

            return;
        }

        if (text.toLowerCase() === "!help") {
            await message.reply(
                "WhatsApp Automation\n\n" +
                "!ping - Test connection\n" +
                "!status - Check bot status\n" +
                "!help - Show commands"
            );

            return;
        }

    } catch (error) {
        console.error(
            "Message handler error:",
            error
        );
    }
});

client.on("error", (error) => {
    console.error(
        "WhatsApp client error:",
        error
    );
});

process.on("SIGINT", async () => {
    console.log("Shutting down...");

    try {
        await client.destroy();
    } catch (error) {
        console.error(error.message);
    }

    process.exit(0);
});

process.on("SIGTERM", async () => {
    console.log("Shutting down...");

    try {
        await client.destroy();
    } catch (error) {
        console.error(error.message);
    }

    process.exit(0);
});

client.initialize().catch((error) => {
    console.error("");
    console.error("======================================");
    console.error(" WHATSAPP INITIALIZATION FAILED");
    console.error("======================================");
    console.error(error);
});